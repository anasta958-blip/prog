{
  "name": "stroysklad-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Local Playwright test harness for the CRM project",
  "type": "commonjs",
  "scripts": {
    "test:db:setup": "powershell -ExecutionPolicy Bypass -File .\\tests\\setup-test-db.ps1",
    "test:server": "powershell -ExecutionPolicy Bypass -File .\\tests\\start-test-server.ps1",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
