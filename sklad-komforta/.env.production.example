# Public HTTPS host without a scheme.
APP_DOMAIN=app.example.com

# Host paths to certificates issued by Let's Encrypt or another trusted CA.
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/app.example.com/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/app.example.com/privkey.pem

# Managed PostgreSQL and Redis endpoints. Require TLS in production.
DATABASE_CONNECTION_STRING=Host=db.example.com;Port=5432;Database=sklad_komforta;Username=sklad;Password=replace-me;SSL Mode=Require;Trust Server Certificate=false
REDIS_CONNECTION_STRING=redis.example.com:6380,password=replace-me,ssl=true,abortConnect=false

# Any S3-compatible storage endpoint.
S3_SERVICE_URL=https://s3.example.com
S3_PUBLIC_URL=https://files.example.com
S3_REGION=eu-central-1
S3_BUCKET=sklad-komforta-production
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=false

JWT_ISSUER=https://app.example.com
JWT_AUDIENCE=sklad-komforta-clients
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-random-key
BOOTSTRAP_TOKEN=replace-with-at-least-24-random-characters

